# 天气挂件（可选，和风天气控制台申请：https://console.qweather.com）
QWEATHER_KEY=

# 本地编辑器鉴权（可选；默认本地无鉴权，仅当需要防止局域网误触时使用）
# 开启后，/api/notes 写接口要求请求头携带 Authorization: Bearer <EDITOR_TOKEN>；
# 浏览器端请把同名值存入 localStorage 的 editor_token 键（本地个人使用）
EDITOR_TOKEN=

# 本地编辑器保存后自动 git commit + push 到 GitHub（默认开启；置 0 关闭；生产环境始终关闭）
AUTO_PUSH=1

# 音乐管理：本地音频上传大小上限（MB，默认 50）
MUSIC_MAX_MB=50

# 音乐管理：本地音频文件是否随 git 提交（默认 1=提交入库随部署发布；置 0=不入库，生产需另行上传音频）
MUSIC_COMMIT_FILES=1

# 照片墙：单张图片上传大小上限（MB，默认 10）
PHOTO_MAX_MB=10
